output/releases/ export-ignore
tmp/ export-ignore
build/ export-ignore
dist/ export-ignore
*.pdf binary
*.safetensors binary
*.zip binary

# Arm migration (agent/gcp-multitopology-v3): Cycle B2 tensor corpus, preserved
# finalist/control checkpoints, and scenario archives go through Git LFS.
# Listed narrowly by directory -- this must not silently pick up unrelated
# future .safetensors/.pt files elsewhere in the repo.
data/learning-v2/cycle-b2/tensors/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
data/learning-v2/cycle-b2/tensors-normalized/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
# core-issues4.txt Section F step 6b: cycle-b2-control-v2's merged tensor
# shards (targets differ from cycle-b2's own; inputs/topology identical) --
# same sharded-safetensors convention as cycle-b2 itself, above.
data/learning-v2/cycle-b2-control-v2/tensors/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
data/learning-v2/cycle-b2-control-v2/tensors-normalized/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
# core-issues3.txt Phase 10.4: balanced supported-category OOD extension corpus.
data/learning-v2/cycle-b2-ood-extension/tensors/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
data/learning-v2/cycle-b2-ood-extension/tensors-normalized/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
models/cycle-b2-candidates/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
models/cycle-b2-candidates/**/*.pt filter=lfs diff=lfs merge=lfs -text
models/cycle-b2-controls/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
artifacts/migration/**/*.tar.zst filter=lfs diff=lfs merge=lfs -text

# core-issues2.txt Phase 7: trajectory-target-enriched tensor shards (merged
# from data/learning-v2/cycle-b2-trajectories/*.jsonl via
# scripts/merge_trajectory_targets.py) go through Git LFS, matching the
# existing cycle-b2 tensors{,-normalized} convention. The trajectory JSONL
# files themselves stay regular git text, matching how scenario manifests
# elsewhere in this repo are not LFS-tracked.
data/learning-v2/cycle-b2-trajectories/tensors-enriched/**/*.safetensors filter=lfs diff=lfs merge=lfs -text

# core-issues3.txt Phase 1-3 corpus regeneration: cycle-b2-trajectories-v2's
# train.jsonl (9000 scenarios, 123 MB) exceeds GitHub's 100 MB regular-blob
# limit -- a narrow, size-driven exception to the "trajectory JSONL stays
# regular git text" convention above, not a policy reversal (the other
# three splits in this same directory are well under the limit and remain
# plain text). Tracked by exact filename, not a directory-wide glob, so a
# future smaller split file in this same directory is not silently pulled
# into LFS too.
data/learning-v2/cycle-b2-trajectories-v2/train.jsonl filter=lfs diff=lfs merge=lfs -text

# core-issues3.txt Phase 10.2/10.3: cycle-b2-trajectories-v3's derived
# Scout-state and Strategist-candidate tensor shards (merged onto
# cycle-b2's own base tensors-normalized inputs by scripts/
# build_scout_state_dataset.py / build_strategist_candidate_dataset.py) --
# same sharded-safetensors-through-LFS convention as every other tensor
# corpus above.
data/learning-v2/cycle-b2-trajectories-v3/scout-tensors-normalized/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
data/learning-v2/cycle-b2-trajectories-v3/strategist-tensors-normalized/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
