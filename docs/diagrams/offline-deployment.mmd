%% Diagram F -- deployment/offline architecture (submission.txt SS14.6)
%% Alt text: a browser talks to FastAPI over localhost only; FastAPI talks
%% to SQLite/local files and HydroCore-v4 plus WNTR, all on one machine.
%% No cloud runtime dependency, no remote map tiles, no hosted model API.
flowchart TD
  B["Browser"] <-->|"localhost:8765 only"| F["FastAPI"]
  F <--> S["SQLite / local files"]
  F <--> H["HydroCore-v4 + WNTR"]

  N1["NO CLOUD RUNTIME DEPENDENCY"]
  N2["NO REMOTE MAP TILES"]
  N3["NO HOSTED MODEL API"]

  classDef boundary fill:#f16c62,stroke:#7a221c,color:#1a0503,font-weight:bold;
  class N1,N2,N3 boundary;
