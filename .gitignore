# Arm migration (agent/gcp-multitopology-v3): narrow exceptions so the
# corrected Cycle B2 corpus can be committed through Git LFS without
# exposing cycle-a/cycle-b (old) or any future cycle's shards. Raw scenario
# .npz arrays stay ignored everywhere, including cycle-b2 -- those are
# preserved as compressed archives under artifacts/migration/ instead (see
# .gitattributes and docs/ARM_MIGRATION.md).
!data/learning-v2/cycle-b2/tensors/**/*.safetensors
!data/learning-v2/cycle-b2/tensors-normalized/**/*.safetensors
# core-issues4.txt Section F step 6b: cycle-b2-control-v2's own merged
# tensor shards (same convention as cycle-b2 above -- targets differ,
# inputs/topology are the same real, non-regenerated data).
!data/learning-v2/cycle-b2-control-v2/tensors/**/*.safetensors
!data/learning-v2/cycle-b2-control-v2/tensors-normalized/**/*.safetensors
# core-issues3.txt Phase 10.4: the balanced supported-category OOD
# extension corpus (real, independently-generated development_holdout-only
# scenarios for EXTREME_DEMAND/TANK_STATE_SHIFT/ROUGHNESS_MISMATCH/
# FROZEN_DRIFTING_SENSOR). Raw scenario .npz arrays stay ignored, same as
# every other corpus above -- only the tensor shards are committed.
!data/learning-v2/cycle-b2-ood-extension/tensors/**/*.safetensors
!data/learning-v2/cycle-b2-ood-extension/tensors-normalized/**/*.safetensors
models/checkpoints/
experiments/cache/
experiments/runs/
experiments/registry/*.lock
experiments/jobs/*/job.lock
experiments/jobs/*/job.pid
/temp.inp
/temp.bin
/temp.rpt

# Locally generated release and browser-test artifacts. Historical submission
# evidence logs remain tracked; only transient final-head logs are ignored.
/RELEASE_MANIFEST.json
/frontend/reports/
/output/releases/
/reports/submission-readiness/jobs/*.pid
/reports/submission-readiness/jobs/final-head-playwright.log
/reports/submission-readiness/jobs/final-head-pytest.log
/reports/submission-readiness/jobs/release-path-validation.log
